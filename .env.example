NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# PostgreSQL usado pela API, por npm run db:setup / db:migrate / db:seed.
# Sem DATABASE_URL, development/test usam dados em memória (x-data-source: mock);
# production exige a variável. Com o banco do docker compose:
DATABASE_URL=postgresql://banco_inter:banco_inter_local@127.0.0.1:5432/banco_inter

# Docker Compose: portas no computador, credenciais do banco local e seed.
# HOST e PORT acima configuram a execução com Node; no container, a API usa
# HOST=0.0.0.0 e PORT=3000, com a porta externa definida por API_PORT.
API_PORT=3000
API_NODE_ENV=development
POSTGRES_PORT=5432
POSTGRES_DB=banco_inter
POSTGRES_USER=banco_inter
POSTGRES_PASSWORD=banco_inter_local
# if-empty: grava a massa de demonstração só no primeiro up; reset: recria com
# horários renovados (use antes de uma demo); off: não grava.
SEED_DEMO=if-empty

# Testes de integração (npm run test:db, npm run coverage). Use um banco
# descartável: cada teste cria e apaga o próprio schema.
# TEST_DATABASE_URL=postgresql://banco_inter:banco_inter_local@127.0.0.1:5432/banco_inter

# Listener Sepolia (sem chave privada): npm run chain:sync
# SEPOLIA_RPC_URL=https://sepolia.example-rpc.invalid/v2/sua-chave
# CREDIT_INTERBANK_OFFER_ADDRESS=0x2401d88D300dD2CEdB83337bba9Ba29E7269079A
# BRL_TOKEN_ADDRESS=0x9591db5fa1345Cc12e7b8F747a3DdAeecc83d25D
# CDI_POSITION_TOKEN_ADDRESS=0xae1C70253946E2a4Cf42c1C979ABD9E8d76AE3c7
# CREDIT_INTERBANK_OFFER_START_BLOCK=11852299
# CHAIN_SYNC_CONFIRMATIONS=12
# O plano gratuito da Alchemy aceita no máximo 10 blocos por eth_getLogs.
# CHAIN_SYNC_INTERVAL_MS=15000
